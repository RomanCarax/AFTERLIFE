{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AFTERLIFE",
  "version": "0.1.0",
  "identifier": "com.afterlife.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AFTERLIFE",
        "width": 420,
        "height": 650,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "backgroundColor": "#0A080A",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' blob: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
